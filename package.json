{
  "name": "vaas-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "bash scripts/dev.sh",
    "dev:api": "cd backend && .venv/bin/uvicorn app.main:app --port 8000",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:stage": "tsc -b && vite build --mode stage",
    "build:prod": "tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepare": "husky",
    "precommit": "lint-staged",
    "i18n:scan": "npx i18next-parser",
    "i18n:update": "cp src/i18n/locales/en/translation.json public/locales/en/translation.json && cp src/i18n/locales/es/translation.json public/locales/es/translation.json"
  },
  "dependencies": {
    "@getvaas/viplay-ui": "^2.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "keycloak-js": "^26.2.1",
    "lucide-react": "^0.453.0",
    "pdfjs-dist": "3.4.120",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.1.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.2",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.6.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.6",
    "postcss": "^8.4.47",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.8"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit --maxWorkers=50%"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "npm run test -- --passWithNoTests"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
